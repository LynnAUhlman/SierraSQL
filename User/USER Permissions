-- replace iii_user.name equals string with the user login name [insert username here] and remove the brackets. 

SELECT
  '   * (' || p.permission_num || ') ' || p.permission_name AS permission_detail
FROM sierra_view.iii_user_permission_myuser AS p
INNER JOIN sierra_view.iii_user AS u
  ON p.iii_user_id = u.id
WHERE
  u.name = '[insert username here]'
ORDER BY
  u.name,
  p.permission_num;
