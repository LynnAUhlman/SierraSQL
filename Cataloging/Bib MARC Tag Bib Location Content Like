/*
Lynn Uhlman
Maine InfoNet
Bib contains specific MARC tag, bib location, and field content LIKE
*/

WITH recent_bibs AS (
  SELECT rm.id
  FROM sierra_view.record_metadata rm
  WHERE rm.record_type_code = 'b'
    AND rm.creation_date_gmt >= '2014-01-01'
    AND rm.creation_date_gmt <  '2026-02-14'
),

series_490 AS (
  SELECT v.record_id, v.field_content
  FROM sierra_view.varfield v
  JOIN recent_bibs r
    ON r.id = v.record_id
  WHERE v.marc_tag = '490'
    AND v.marc_ind1 = '1'
    AND v.field_content ~ '[0-9]{4}'  -- must contain 4-digit year
)

SELECT 
  id2reckey(s.record_id)||'a' AS bib_record_num,
  brl.location_code AS bib_location,
  s.field_content AS series_490,
  t.field_content AS title_245

FROM series_490 s

JOIN sierra_view.varfield t
  ON t.record_id = s.record_id
  AND t.marc_tag = '245'
  
JOIN sierra_view.bib_record_location brl
  ON brl.bib_record_id = s.record_id

WHERE s.field_content ILIKE ANY (ARRAY[
        '%January%', '%February%', '%March%', '%April%',
        '%May%', '%June%', '%July%', '%August%',
        '%September%', '%October%', '%November%', '%December%'
      ])
      AND brl.location_code LIKE 'kbk%'

ORDER BY 1;
